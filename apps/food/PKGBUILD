# Maintainer: Simon Schubert <simon@librem.one>
pkgname=moarchy-food
pkgver=0.1.0
pkgrel=1
pkgdesc="Point the camera at a barcode: nutrition facts from Open Food Facts"
arch=('any')
url="https://github.com/SimonSchubert/moarchy-apps"
license=('MIT')
# Pure Python, so arch=any. The GUI stack is all runtime, nothing is compiled.
#
# The camera is not optional. There is no typed barcode, so without a pipeline
# that can see one the app is an empty state. gstreamer and the two plugin
# packages are the Linux camera; gst-plugins-bad is where zbar lives;
# gst-plugin-gtk4 is the sink that paints the viewfinder into a Gtk.Picture.
# zbar is listed because gst-plugins-bad treats it as optional, and an
# optional decoder is a scanner that cannot scan.
depends=(
  'python'
  'python-gobject'
  'gtk4'
  'libadwaita'
  'gstreamer'
  'gst-plugins-base'
  'gst-plugins-good'
  'gst-plugins-bad'
  'gst-plugin-gtk4'
  'zbar'
)
source=("$url/releases/download/food-v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

# The source tarball is assembled by packaging/release.sh from two subtrees of
# one tag -- apps/food and shared -- so it holds this app and the shared code it
# uses and nothing else. That is what lets a monorepo keep per-app versions:
# `git archive <tag>:<subdir>` means one repo does not mean one version number.
#
# Deliberately a versioned package rather than a -git one, and a release asset
# rather than GitHub's auto-generated archive. Both arguments are in
# apps/vitals/PKGBUILD in full; neither is any different here.

check() {
  cd "$srcdir/$pkgname-$pkgver"
  # Parsing somebody else's JSON and writing our own file, against records
  # written by hand in tests/. That is the whole reason nothing in facts.py or
  # store.py imports gi: a build chroot has no display, and neither the shape of
  # an answer nor the checksum of a barcode needs one. Nothing here opens a
  # socket either -- the one class that would is driven through a stand-in for
  # urlopen, because a build must not depend on Open Food Facts being up. The
  # widget tests skip themselves without a display; scripts/check.sh runs those.
  PYTHONPATH=. python3 -m unittest discover -s tests
}

package() {
  cd "$srcdir/$pkgname-$pkgver"

  # Deliberately NOT site-packages. That path is Python-version-specific
  # (/usr/lib/python3.13/site-packages), and this is an arch=any package: the
  # version that built it would be baked in, so a Python minor bump would break
  # every installed copy until rebuilt. A private dir on sys.path is immune.
  install -Dm644 moarchy_food/*.py -t "$pkgdir/usr/lib/$pkgname/moarchy_food/"

  # The shared code is vendored into this package rather than being a package of
  # its own. The store reports what an app costs in packages and megabytes onto
  # a stock image, and a second package for two hundred lines of palette
  # arithmetic is a cost with nothing behind it. One source copy in the repo,
  # one self-contained package here, no runtime coupling between apps.
  install -Dm644 moarchy_ui/*.py -t "$pkgdir/usr/lib/$pkgname/moarchy_ui/"

  install -Dm755 launcher "$pkgdir/usr/bin/moarchy-food"

  install -Dm644 data/org.moarchy.Food.desktop \
    "$pkgdir/usr/share/applications/org.moarchy.Food.desktop"
  install -Dm644 data/org.moarchy.Food.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/org.moarchy.Food.svg"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
