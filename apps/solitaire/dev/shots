# What to photograph, for scripts/app-shot.sh.
shot phone
shot phone-light LOOK=light
shot phone-picked MOARCHY_SOLITAIRE_PICK=auto
shot phone-record MOARCHY_SOLITAIRE_PAGE=record
shot phone-newdeal MOARCHY_SOLITAIRE_NEW=1
shot phone-home DEMO=home
shot phone-tokyo THEME=.themes/tokyo-night/colors.toml
shot desktop SIZE=1280x820
shot desktop-light SIZE=1280x820 LOOK=light MOARCHY_SOLITAIRE_PICK=auto
shot desktop-latte SIZE=1280x820 THEME=.themes/catppuccin-latte/colors.toml DEMO=home

# The store's three, for App Finder: a deal in progress, a run picked up, and
# one ready to go home. scripts/app-shot.sh's themed mode shoots these once
# per Omarchy theme.
STORE="SIZE=540x1044 SCALE=1.5"
shot store-1-game $STORE
shot store-2-picked $STORE MOARCHY_SOLITAIRE_PICK=auto
shot store-3-home $STORE DEMO=home
