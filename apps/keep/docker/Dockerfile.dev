# Run-and-photograph environment for moarchy-keep.
#
# The app is pure Python, so nothing here compiles -- what the container gives
# you is the GNOME stack the phone has and this Mac does not, at the versions
# Arch Linux ARM ships. On Apple Silicon it runs natively, so a screenshot run
# takes seconds.
#
#   docker build --platform linux/arm64 -f docker/Dockerfile.dev -t moarchy-keep-dev .
#   docker run --rm --platform linux/arm64 -v "$PWD:/src" -w /src moarchy-keep-dev ./scripts/check.sh
#
FROM --platform=linux/arm64 menci/archlinuxarm:base

# Docker Desktop's Linux VM kernel does not expose Landlock, which pacman 7
# uses to sandbox downloads. Same fix as mobileomarchy's own builder image.
RUN sed -i '/^\[options\]/a DisableSandbox' /etc/pacman.conf

RUN pacman-key --init && pacman-key --populate archlinuxarm && \
    pacman -Syu --noconfirm --needed \
      python python-gobject gtk4 libadwaita \
      adwaita-icon-theme adwaita-fonts cantarell-fonts ttf-dejavu \
      dbus xorg-server-xvfb xorg-xdpyinfo xdotool imagemagick \
      ruff && \
    pacman -Scc --noconfirm

# No GL in this container, and none on a Mali-400 either: both fall back to the
# software renderer, so what is photographed here is what the phone draws.
ENV GDK_BACKEND=x11 \
    GSK_RENDERER=cairo \
    GDK_DISABLE=gl,vulkan \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /src
