# What to photograph, for scripts/app-shot.sh.
#
# Tuesday 15 September 2026, pinned in both halves: demo.py dates its fixture
# from it and the app reads its day from it. The week starts on Monday, as it
# does on the phone; a container has no locales and would say Sunday.
shot phone MOARCHY_CALENDAR_TODAY=2026-09-15 MOARCHY_CALENDAR_WEEK_START=1
shot phone-light LOOK=light MOARCHY_CALENDAR_TODAY=2026-09-15 MOARCHY_CALENDAR_WEEK_START=1
shot phone-agenda MOARCHY_CALENDAR_TODAY=2026-09-15 MOARCHY_CALENDAR_WEEK_START=1 MOARCHY_CALENDAR_PAGE=agenda
shot phone-editor MOARCHY_CALENDAR_TODAY=2026-09-15 MOARCHY_CALENDAR_WEEK_START=1 MOARCHY_CALENDAR_EDIT=Dentist
shot phone-picker MOARCHY_CALENDAR_TODAY=2026-09-15 MOARCHY_CALENDAR_WEEK_START=1 MOARCHY_CALENDAR_EDIT=Dentist MOARCHY_CALENDAR_PICKING=1
shot phone-empty MOARCHY_CALENDAR_TODAY=2026-09-15 MOARCHY_CALENDAR_WEEK_START=1 MOARCHY_CALENDAR_DAY=2026-09-16
shot phone-tokyo MOARCHY_CALENDAR_TODAY=2026-09-15 MOARCHY_CALENDAR_WEEK_START=1 THEME=.themes/tokyo-night/colors.toml
shot desktop SIZE=1280x820 MOARCHY_CALENDAR_TODAY=2026-09-15 MOARCHY_CALENDAR_WEEK_START=1
shot desktop-light SIZE=1280x820 LOOK=light MOARCHY_CALENDAR_TODAY=2026-09-15 MOARCHY_CALENDAR_WEEK_START=1
shot desktop-editor SIZE=1280x820 MOARCHY_CALENDAR_TODAY=2026-09-15 MOARCHY_CALENDAR_WEEK_START=1 MOARCHY_CALENDAR_EDIT=Dentist
shot desktop-agenda SIZE=1280x820 MOARCHY_CALENDAR_TODAY=2026-09-15 MOARCHY_CALENDAR_WEEK_START=1 MOARCHY_CALENDAR_PAGE=agenda
shot desktop-latte SIZE=1280x820 MOARCHY_CALENDAR_TODAY=2026-09-15 MOARCHY_CALENDAR_WEEK_START=1 THEME=.themes/catppuccin-latte/colors.toml

# The store's three, for App Finder: the month with today's events, the agenda,
# and an event open in the editor. scripts/app-shot.sh's themed mode shoots
# these once per Omarchy theme.
STORE="SIZE=540x1044 SCALE=1.5"
shot store-1-month $STORE MOARCHY_CALENDAR_TODAY=2026-09-15 MOARCHY_CALENDAR_WEEK_START=1
shot store-2-agenda $STORE MOARCHY_CALENDAR_TODAY=2026-09-15 MOARCHY_CALENDAR_WEEK_START=1 MOARCHY_CALENDAR_PAGE=agenda
shot store-3-editor $STORE MOARCHY_CALENDAR_TODAY=2026-09-15 MOARCHY_CALENDAR_WEEK_START=1 MOARCHY_CALENDAR_EDIT=Dentist
