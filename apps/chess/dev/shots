# What to photograph, for scripts/app-shot.sh.
shot phone
shot phone-light LOOK=light
shot phone-held MOARCHY_CHESS_SELECT=auto
shot phone-record MOARCHY_CHESS_PAGE=record
shot phone-newgame MOARCHY_CHESS_NEW=1
shot phone-promote MOARCHY_CHESS_PROMOTE=1
shot phone-mate DEMO=mate
shot desktop SIZE=1280x820
shot desktop-light SIZE=1280x820 LOOK=light MOARCHY_CHESS_SELECT=auto
shot desktop-tokyo SIZE=1280x820 THEME=.themes/tokyo-night/colors.toml
shot desktop-mate SIZE=1280x820 DEMO=mate THEME=.themes/catppuccin-latte/colors.toml

# The store's three, for App Finder: a game in progress, a piece held with its
# moves, and a mate. scripts/app-shot.sh's themed mode shoots these once per
# Omarchy theme.
STORE="SIZE=540x1044 SCALE=1.5"
shot store-1-game $STORE
shot store-2-held $STORE MOARCHY_CHESS_SELECT=auto
shot store-3-mate $STORE DEMO=mate
