# What to photograph, for scripts/app-shot.sh. Every shot is offline, on the
# answers dev/capture.py recorded and at the moment it recorded them, signed
# in with the lists dev/demo.py made up, with the pictures capture.py saved
# in dev/.images (run capture.py first, or every poster is a tinted card with
# its title on it, which is also what it is with no signal).
FX=apps/couch-for-trakt/dev/fixture.json
NOW=MOARCHY_COUCH_FOR_TRAKT_NOW=$(jq .NOW "$FX")
IMAGES=MOARCHY_COUCH_FOR_TRAKT_IMAGES=$PWD/apps/couch-for-trakt/dev/.images
SHOW=MOARCHY_COUCH_FOR_TRAKT_OPEN=show:$(jq .SHOW "$FX")
MOVIE=MOARCHY_COUCH_FOR_TRAKT_OPEN=movie:$(jq .MOVIE "$FX")
# The same bytes every run. The calendar is by day, and the fixture's days
# are UTC ones. Distance-field text and the texture atlas are laid out in the
# order glyphs and pictures happen to arrive, and the threaded render loop
# now and then draws a frame the basic one does not; each moves an edge by a
# level of grey from one run to the next, and none is used here. GL, not the
# software renderer app-shot.sh picks for everyone: that one draws the
# pictures a shade differently from run to run.
RUN="$NOW $IMAGES TZ=UTC QT_QUICK_BACKEND=rhi QML_DISABLE_DISTANCEFIELD=1 QSG_ATLAS_SIZE_LIMIT=1 QSG_RENDER_LOOP=basic"

shot phone $RUN
shot phone-calendar $RUN MOARCHY_COUCH_FOR_TRAKT_PAGE=calendar
shot phone-latte THEME=.themes/catppuccin-latte/colors.toml $RUN MOARCHY_COUCH_FOR_TRAKT_PAGE=watchlist
shot desktop SIZE=1280x820 $RUN MOARCHY_COUCH_FOR_TRAKT_TYPE=show
shot desktop-movie SIZE=1280x820 $RUN $MOVIE
shot desktop-calendar SIZE=1280x820 THEME=.themes/catppuccin-latte/colors.toml $RUN MOARCHY_COUCH_FOR_TRAKT_PAGE=calendar

# The store's three, at a phone's 360 px on its density.
STORE="SIZE=540x1044 SCALE=1.5 THEME=.themes/tokyo-night/colors.toml"
shot store-1-discover $STORE $RUN
shot store-2-show $STORE $RUN $SHOW
shot store-3-upnext $STORE $RUN MOARCHY_COUCH_FOR_TRAKT_PAGE=upnext
