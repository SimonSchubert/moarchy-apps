# What to photograph, for scripts/app-shot.sh. The day is pinned, so the word
# under the tiles is the same word every time.
shot phone MOARCHY_FIVELETTERS_TODAY=2026-09-12 MOARCHY_FIVELETTERS_TYPED=SPINE
shot phone-light LOOK=light MOARCHY_FIVELETTERS_TODAY=2026-09-12
shot phone-solved MOARCHY_FIVELETTERS_TODAY=2026-09-12 DEMO=solved
shot phone-lost LOOK=light MOARCHY_FIVELETTERS_TODAY=2026-09-12 DEMO=lost
shot phone-record MOARCHY_FIVELETTERS_TODAY=2026-09-12 MOARCHY_FIVELETTERS_PAGE=record
shot phone-tokyo THEME=.themes/tokyo-night/colors.toml MOARCHY_FIVELETTERS_TODAY=2026-09-12
shot desktop SIZE=1280x820 MOARCHY_FIVELETTERS_TODAY=2026-09-12 MOARCHY_FIVELETTERS_TYPED=SPI
shot desktop-light SIZE=1280x820 LOOK=light MOARCHY_FIVELETTERS_TODAY=2026-09-12 DEMO=solved
shot desktop-latte SIZE=1280x820 THEME=.themes/catppuccin-latte/colors.toml MOARCHY_FIVELETTERS_TODAY=2026-09-12

# The store's three, for App Finder: a word being typed, a solved day and the
# record. scripts/app-shot.sh's themed mode shoots these once per Omarchy
# theme.
STORE="SIZE=540x1044 SCALE=1.5"
shot store-1-typing $STORE MOARCHY_FIVELETTERS_TODAY=2026-09-12 MOARCHY_FIVELETTERS_TYPED=SPINE
shot store-2-solved $STORE MOARCHY_FIVELETTERS_TODAY=2026-09-12 DEMO=solved
shot store-3-record $STORE MOARCHY_FIVELETTERS_TODAY=2026-09-12 MOARCHY_FIVELETTERS_PAGE=record
